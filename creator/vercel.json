{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/local-capture/:path*", "destination": "https://mc-zdnmms5ls0.bunny.run/api/local-capture/:path*" },
    { "source": "/healthz", "destination": "https://mc-zdnmms5ls0.bunny.run/healthz" }
  ],
  "headers": [
    { "source": "/api/local-capture/:path*", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
    ] }
  ]
}
