APP_ORIGIN=http://127.0.0.1:5178
# Generate a random 32-byte key and base64-encode it. Store only in backend secrets.
# Keep prior versions available during key rotation; never prefix with VITE_.
PROVIDER_ENCRYPTION_KEYS={"v1":"BASE64_ENCODED_32_BYTE_KEY"}
PROVIDER_KEY_VERSION=v1
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted runtime.
# Perplexity credentials are server-side Function secrets only. Never use a VITE_ prefix.
CREATOR_PERPLEXITY_API_KEY=
# Optional: defaults to the documented Agent API model in the research provider.
CREATOR_PERPLEXITY_RESEARCH_MODEL=
# Apify token for server-side native video discovery. Never expose in browser code.
CREATOR_APIFY_API_TOKEN=
